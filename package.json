{
  "publisher": "aacalculus",
  "name": "visualnoveltranslator",
  "displayName": "VisualNovelTranslator",
  "description": "A visual novel translator extension for vscode, based on HY-MT1.5 model.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MSJavaScript/VScode.VisualNovelTranslator.git"
  },
  "activationEvents": [
    "onCommand:visualnoveltranslator.translateRpy",
    "onCommand:visualnoveltranslator.openChat",
    "onCommand:visualnoveltranslator.sendToChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visualnoveltranslator.translateRpy",
        "title": "Translate RPY Line"
      },
      {
        "command": "visualnoveltranslator.openChat",
        "title": "Open Translation Chat"
      },
      {
        "command": "visualnoveltranslator.sendToChat",
        "title": "Send to Translation Chat"
      }
    ],
    "keybindings": [
      {
        "command": "visualnoveltranslator.translateRpy",
        "key": "ctrl+alt+t",
        "when": "resourceExtname == .rpy"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "visualnoveltranslator.sendToChat",
          "when": "editorHasSelection",
          "group": "7_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}